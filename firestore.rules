rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 拠点：誰でも閲覧可・追加のみ可（編集/削除は不可）
    match /spots/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name','genre','lat','lng','createdAt','osmId'])
        && (!('osmId' in request.resource.data) || (request.resource.data.osmId is string && request.resource.data.osmId.size() <= 60))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.genre in ['gas','super','bousai','water','medical','bath','road','other']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat > 24 && request.resource.data.lat < 46
        && request.resource.data.lng > 122 && request.resource.data.lng < 154;
      allow update, delete: if false;
    }

    // 投稿：誰でも閲覧可・追加のみ可（編集/削除は不可）
    match /posts/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['spotId','text','nickname','createdAt'])
        && request.resource.data.spotId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
      allow update, delete: if false;
    }

    // 作者へのご意見・要望：誰でも閲覧・投稿可（編集/削除は不可）
    match /feedback/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['text','nickname','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
      allow update, delete: if false;
    }

    // 閲覧数：誰でも閲覧可。1ずつの増加のみ許可
    match /views/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // 緊急ヘルプ：誰でも閲覧・投稿可。ステータス変更のみ更新を許可
    match /help/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['text','nickname','category','status','createdAt','updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 20
        && request.resource.data.status == 'open';
      // 更新できるのは status と updatedAt のみ（本文の改ざん防止）
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['open','resolved','closed'];
      allow delete: if false;
    }

    // ヘルプへの返信：誰でも閲覧・投稿可（編集/削除は不可）
    match /helpReplies/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['helpId','text','nickname','createdAt'])
        && request.resource.data.helpId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
      allow update, delete: if false;
    }
  }
}
